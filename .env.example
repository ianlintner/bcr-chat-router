# Optional: enables Jev-based classification. Without it, the rule-based
# fallback classifier handles all routing (fine for dev/CI).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_TIMEOUT_SECONDS=4

# Confidence below this always routes to the human queue in addition to
# whatever label won.
MIN_CONFIDENCE=0.55
